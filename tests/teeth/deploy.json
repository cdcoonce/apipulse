{
  "runner": "pytest",
  "test_command": ["uv", "run", "pytest", "-q", "-p", "no:cacheprovider", "tests/test_deploy.py"],
  "collect_command": ["uv", "run", "pytest", "--collect-only", "-q", "-p", "no:cacheprovider", "tests/test_deploy.py"],
  "mutants": [
    {"label": "verify never reports stale", "file": "../../scripts/verify_run.sh", "oracle": "real",
     "find": "if age_hours > MAX_AGE_HOURS:", "replace": "if False:"},
    {"label": "verify judges the OLDEST monthly file", "file": "../../scripts/verify_run.sh", "oracle": "real",
     "find": "latest = files[-1]", "replace": "latest = files[0]"},
    {"label": "no-parquet exit code collapses into stale", "file": "../../scripts/verify_run.sh", "oracle": "real",
     "find": "    sys.exit(2)", "replace": "    sys.exit(1)"},
    {"label": "verify counts apis instead of rollups", "file": "../../scripts/verify_run.sh", "oracle": "real",
     "find": "SELECT COUNT(*) FROM rollups", "replace": "SELECT COUNT(*) FROM apis"},
    {"label": "env var beats the explicit argument", "file": "../../scripts/verify_run.sh", "oracle": "real",
     "find": "data_dir=\"${1:-${APIPULSE_DATA_DIR:-data}}\"", "replace": "data_dir=\"${APIPULSE_DATA_DIR:-${1:-data}}\""},
    {"label": "cron renders even when probe failed", "file": "../../deploy/cron/apipulse.cron", "oracle": "real",
     "find": "apipulse probe && /home", "replace": "apipulse probe ; /home"},
    {"label": "cron refresh runs without the shared lock", "file": "../../deploy/cron/apipulse.cron", "oracle": "real",
     "find": "30 0 * * 0 APIPULSE_DATA_DIR=/home/cdcoonce/src/apipulse/data flock -w 3600 /home/cdcoonce/.local/state/apipulse/run.lock /bin/sh",
     "replace": "30 0 * * 0 APIPULSE_DATA_DIR=/home/cdcoonce/src/apipulse/data /bin/sh"},
    {"label": "cron probe back at 03:30 (inside the reboot window)", "file": "../../deploy/cron/apipulse.cron", "oracle": "real",
     "find": "0 1 * * * APIPULSE", "replace": "30 3 * * * APIPULSE"},
    {"label": "cron probe uses a different lock file", "file": "../../deploy/cron/apipulse.cron", "oracle": "real",
     "find": "/home/cdcoonce/.local/state/apipulse/run.lock /bin/sh -c 'cd /home/cdcoonce/src/apipulse && /home/cdcoonce/.local/bin/uv run --frozen apipulse probe",
     "replace": "/home/cdcoonce/.local/state/apipulse/probe.lock /bin/sh -c 'cd /home/cdcoonce/src/apipulse && /home/cdcoonce/.local/bin/uv run --frozen apipulse probe"},
    {"label": "systemd only restarts on failure", "file": "../../deploy/systemd/apipulse-serve.service", "oracle": "real",
     "find": "Restart=always", "replace": "Restart=on-failure"},
    {"label": "systemd serve binds all interfaces", "file": "../../deploy/systemd/apipulse-serve.service", "oracle": "real",
     "find": "serve --host 127.0.0.1", "replace": "serve --host 0.0.0.0"},
    {"label": "serve plist binds all interfaces", "file": "../../deploy/launchd/com.cdcoonce.apipulse.serve.plist", "oracle": "real",
     "find": "<string>127.0.0.1</string>", "replace": "<string>0.0.0.0</string>"},
    {"label": "refresh plist on Monday", "file": "../../deploy/launchd/com.cdcoonce.apipulse.refresh.plist", "oracle": "real",
     "find": "<key>Weekday</key>\n        <integer>0</integer>", "replace": "<key>Weekday</key>\n        <integer>1</integer>"},
    {"label": "probe plist renders before probing", "file": "../../deploy/launchd/com.cdcoonce.apipulse.probe.plist", "oracle": "real",
     "find": "apipulse probe &amp;&amp; /Users/cdcoonce/.local/bin/uv run --frozen apipulse render",
     "replace": "apipulse render &amp;&amp; /Users/cdcoonce/.local/bin/uv run --frozen apipulse probe"},
    {"label": "[control] print rows before the latest-parquet line", "file": "../../scripts/verify_run.sh", "oracle": "real",
     "expect": "survived",
     "why": "Both lines print values computed before either print (latest and its metadata); swapping only changes stdout line order. Tests assert substrings of stdout and the exit code, never line order. Not inert for a human or a script that parses line 1 as the file name; the runbook does not do that.",
     "find": "print(f\"latest parquet: {latest} (age {age_hours:.1f} h)\")\nprint(f\"rows: {pq.read_metadata(latest).num_rows}\")",
     "replace": "print(f\"rows: {pq.read_metadata(latest).num_rows}\")\nprint(f\"latest parquet: {latest} (age {age_hours:.1f} h)\")"}
  ]
}
